# Local host tools: Postgres mapped to localhost:5433 (see docker-compose.yml).
# Inside Docker/Coolify containers, use the service hostname and port 5432 instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/customer_mgmt?schema=public"
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3001
CRM_BASE_DOMAIN="crm.dabriz.com"
CRM_PROTOCOL="https"
ADMIN_EMAIL="admin@dabriz.com"
ADMIN_PASSWORD="Admin123!"
CORS_ORIGIN="http://localhost:3000"
