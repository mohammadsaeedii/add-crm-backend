# Local host tools: Postgres mapped to localhost:5433 (see docker-compose.yml).
# Inside Docker/Coolify containers, use the service hostname and port 5432 instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/customer_mgmt?schema=public"
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3001
CRM_BASE_DOMAIN="crm.dabriz.com"
CRM_PROTOCOL="https"
ADMIN_EMAIL="admin@dabriz.com"
ADMIN_PASSWORD="Admin123!"
CORS_ORIGIN="http://localhost:3000"

# OIDC Identity Provider
OAUTH_ISSUER="http://localhost:3001"
OAUTH_TOKEN_SECRET="change-me-oauth-token-secret"
SSO_FRONTEND_URL="http://localhost:3000"
OAUTH_CRM_CLIENT_ID="multi-tenant-crm"
OAUTH_CRM_CLIENT_SECRET="crm-dev-client-secret-change-me"
# Comma-separated allowlist of CRM callback URLs
OAUTH_CRM_REDIRECT_URIS="http://localhost:3002/auth/sso/callback"

# Provision CRM tenants when Customers are created (CRM internal API)
CRM_API_URL="http://localhost:3002"
CRM_PROVISIONING_SECRET="shared-provisioning-secret-change-me"
